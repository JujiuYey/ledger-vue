{
  // Covers repo-level TypeScript files (configs, test setup) that live outside the packages'
  // own `include: ["src"]` — checked by the root `typecheck` script.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["*.ts", "packages/*/vite.config.ts"]
}
